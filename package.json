{
  "name": "buddy-harmony",
  "version": "0.11.15",
  "homepage": "https://Marthijs-Berfelo.github.io/buddy-harmony",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "eslint src --fix",
    "commit": "cz",
    "release": "release-it",
    "release:ci": "release-it --ci",
    "release:ci-prepare": "echo $(release-it --ci --release-version) > next-version.txt",
    "release:milestone": "release-it minor --ci",
    "release:milestone-prepare": "echo $(release-it minor --ci --release-version) > next-version.txt",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fortawesome/fontawesome-common-types": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tombatossals/chords-db": "^0.5.1",
    "@tonaljs/tonal": "^4.10.0",
    "assert-ts": "^0.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "guitar-scales": "^1.0.4",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^4.0.1",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-flags-select": "^2.5.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.3",
    "react-to-print": "^3.0.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.0.0",
    "@release-it/conventional-changelog": "^11.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-fontawesome": "^1.6.8",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "commitizen": "^4.3.2",
    "cosmiconfig": "^9.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "gh-pages": "^6.0.0",
    "globals": "^15.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.0",
    "release-it": "^20.0.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "eslint --fix"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "release-it": {
    "git": {
      "requiresBranch": "release/**",
      "commitMessage": "chore: release v${version}",
      "requireUpstream": false
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            { "type": "feat", "section": "Features" },
            { "type": "feature", "section": "Features" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "perf", "section": "Performance Improvements" },
            { "type": "revert", "section": "Reverts" },
            { "type": "refactor", "section": "Code Refactoring" },
            { "type": "deps", "section": "Dependency Updates" },
            { "type": "deps-dev", "section": "Dependency Updates" },
            { "type": "chore", "section": "Miscellaneous Chores" },
            { "type": "deps-ci", "section": "CI Dependency Updates", "hidden": true },
            { "type": "ci", "section": "Continuous Integration", "hidden": true },
            { "type": "docs", "section": "Documentation", "hidden": true },
            { "type": "style", "section": "Styles", "hidden": true },
            { "type": "test", "section": "Tests", "hidden": true },
            { "type": "build", "section": "Build System", "hidden": true }
          ]
        },
        "infile": "CHANGELOG.md"
      }
    }
  }
}
